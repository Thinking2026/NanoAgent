{
  "task": {
    "name": "engineering_estimation"
  },
  "agent": {
    "max_tool_iterations": 10,
    "max_attempt_iterations": 60,
    "max_replan_stage_retries": 3,
    "max_stage_retries": 2,
    "latency": {
      "thread_join_timeout_seconds": 1.0,
      "new_task_user_input_timeout_seconds": 60.0,
      "in_progress_wait_command_timeout_seconds": 5.0,
      "hint_input_timeout_seconds": 60.0,
      "agent_message_poll_timeout_seconds": 0.1,
      "user_progress_notice_interval_seconds": 8.0,
      "agent_user_message_wait_timeout_seconds": 2.0
    }
  },
  "llm": {
    "enable_provider_fallback": true,
    "priority_chain": ["deepseek", "claude", "openai"],
    "summary_providers": ["deepseek"],
    "analyzer_provider": ["deepseek"],
    "plan_provider": ["deepseek"],
    "quality_provider": ["deepseek"],
    "context_trimming": {
    },
    "retry": {
      "max_attempts": 5,
      "base": 0.5,
      "max_delay": 60.0
    },
    "provider_settings": {
      "claude": {
        "model": "claude-3-5-sonnet-latest",
        "model_fallback": ["claude-3-5-haiku-latest"],
        "base_url": "https://api.anthropic.com",
        "timeout": 120.0,
        "max_tokens": 1024,
        "anthropic_version": "2023-06-01",
        "context_window": 200000,
        "capabilities": {
          "cognitive_complexity": ["L2", "L3", "L4"],
          "best_scenarios": ["code_generation", "reasoning", "analysis", "research", "writing"],
          "top_strengths": ["instruction_following", "code", "long_context", "tool_use"],
          "cost_tier": "high",
          "latency_tier": "medium",
          "context_size": 200000
        }
      },
      "deepseek": {
        "model": "deepseek-chat",
        "model_fallback": [],
        "base_url": "https://api.deepseek.com/v1",
        "timeout": 120.0,
        "context_window": 64000,
        "capabilities": {
          "cognitive_complexity": ["L2", "L3", "L4"],
          "best_scenarios": ["code_generation", "math", "reasoning", "data_analysis"],
          "top_strengths": ["code", "math", "cost_efficiency"],
          "cost_tier": "low",
          "latency_tier": "fast",
          "context_size": 64000
        }
      },
      "openai": {
        "model": "gpt-4o",
        "model_fallback": ["gpt-4o-mini"],
        "base_url": "https://api.openai.com/v1",
        "timeout": 120.0,
        "context_window": 128000,
        "capabilities": {
          "cognitive_complexity": ["L2", "L3"],
          "best_scenarios": ["general", "code_generation", "analysis", "multimodal", "tool_use"],
          "top_strengths": ["general_purpose", "tool_use", "instruction_following"],
          "cost_tier": "high",
          "latency_tier": "medium",
          "context_size": 128000
        }
      },
      "minmax": {
        "model": "MiniMax-Text-01",
        "model_fallback": [],
        "base_url": "https://api.minimax.chat/v1",
        "timeout": 120.0,
        "context_window": 1000000,
        "capabilities": {
          "cognitive_complexity": ["L1", "L2"],
          "best_scenarios": ["long_document", "summarization", "general"],
          "top_strengths": ["ultra_long_context", "cost_efficiency"],
          "cost_tier": "low",
          "latency_tier": "medium",
          "context_size": 1000000
        }
      },
      "glm": {
        "model": "glm-4",
        "model_fallback": [],
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "timeout": 120.0,
        "context_window": 128000,
        "capabilities": {
          "cognitive_complexity": ["L1", "L2"],
          "best_scenarios": ["general", "chinese_language", "writing"],
          "top_strengths": ["chinese_language", "cost_efficiency"],
          "cost_tier": "low",
          "latency_tier": "fast",
          "context_size": 128000
        }
      },
      "kimi": {
        "model": "moonshot-v1-8k",
        "model_fallback": [],
        "base_url": "https://api.moonshot.cn/v1",
        "timeout": 120.0,
        "context_window": 128000,
        "capabilities": {
          "cognitive_complexity": ["L1", "L2"],
          "best_scenarios": ["general", "chinese_language", "document_qa"],
          "top_strengths": ["chinese_language", "document_understanding"],
          "cost_tier": "medium",
          "latency_tier": "fast",
          "context_size": 128000
        }
      }
    }
  },
  "context": {
    "budget":{
      "strategy": "role_based",
      "role_based": {
        "reserve_ratio": 0.20,
        "role_ratios": {
          "system":    0.1,
          "user":      0.1,
          "assistant": 0.4,
          "tool":      0.4
        }
      }
    },
    "truncation": {
      "strategy": "react",
      "react": {
        "tool_arg_max_chars": 300,
        "tool_result_max_chars": 500,
        "summary_provider": "deepseek",
        "keep_first_units": 1,
        "keep_last_units": 3,
        "summary_ratio": 0.20
      }
    }
  },
  "storage": {
    "backend": "file",
    "file": {
      "path": "tests/runtime/agent_documents.json"
    },
    "sqlite": {
      "allowed_databases": {
        "material_price": "tests/runtime/material_price.db"
      },
      "path": "tests/runtime/material_price.db"
    },
    "chromadb": {
      "persist_directory": "",
      "allowed_collections": ["agent_documents"],
      "collection_name": "agent_documents"
    },
    "mysql": {
      "host": "",
      "port": 3306,
      "allowed_databases": [],
      "database": "",
      "charset": "utf8mb4"
    }
  },
  "tools": {
    "package": null,
    "modules": [],
    "forbidden_tools": [],
    "retry": {
      "max_attempts": 4,
      "backoff_seconds": [1.0, 2.0, 4.0]
    }
  },
  "tracing": {
    "enabled": true,
    "output_path": "var/tracing/traces.jsonl",
    "payload_redaction_enabled": false,
    "max_content_length": 2048
  },
  "log": {
    "dir": "var/logs"
  },
  "time": {
    "timezone": "shanghai"
  }
}
