{
  "task": {
    "name": "travel_plan_design"
  },
  "agent": {
    "max_tool_iterations": 10,
    "max_attempt_iterations": 60,
    "max_replan_stage_retries": 3,
    "max_stage_retries": 2,
    "latency": {
      "thread_join_timeout_seconds": 1.0,
      "new_task_user_input_timeout_seconds": 60.0,
      "in_progress_wait_command_timeout_seconds": 5.0,
      "hint_input_timeout_seconds": 60.0,
      "agent_message_poll_timeout_seconds": 1.0,
      "user_progress_notice_interval_seconds": 8.0,
      "agent_user_message_wait_timeout_seconds": 2.0,
      "loop_user_message_timeout_seconds": 300.0
    }
  },
  "llm": {
    "enable_provider_fallback": true,
    "priority_chain": ["deepseek", "kimi", "glm"],
    "summary_providers": ["kimi"],
    "analyzer_provider": ["glm"],
    "plan_provider": ["glm"],
    "quality_provider": ["deepseek"],
    "context_trimming": {
    },
    "retry": {
      "max_attempts": 3,
      "base": 0.5,
      "max_delay": 60.0
    },
    "provider_settings": {
      "claude": {
        "model": "claude-3-5-sonnet-latest",
        "model_fallback": ["claude-3-5-haiku-latest"],
        "base_url": "https://api.anthropic.com",
        "timeout": 120.0,
        "max_tokens": 16000,
        "enable_thinking": false,
        "thinking_budget_tokens": 10000,
        "anthropic_version": "2023-06-01",
        "context_window": 200000,
        "capabilities": {
          "cognitive_complexity": ["L2", "L3", "L4"],
          "best_scenarios": ["code_generation", "reasoning", "analysis", "research", "writing"],
          "capability_tags": ["code", "reasoning", "tool_use", "long_context", "writing", "general"],
          "preferred_task_types": ["code_generation", "reasoning", "analysis", "research", "technical_writing"],
          "cost_tier": "high",
          "latency": "medium",
          "context_size": 200000
        }
      },
      "deepseek": {
        "model": "deepseek-v4-pro",
        "model_fallback": ["deepseek-v4-flash"],
        "base_url": "https://api.deepseek.com",
        "timeout": 120.0,
        "max_tokens": 128000,
        "enable_thinking": false,
        "thinking_model": "deepseek-reasoner",
        "context_window": 1000000,
        "capabilities": {
          "cognitive_complexity": ["L3", "L4"],
          "best_scenarios": ["high scale reasoning", "math", "code generation", "data analysis"],
          "capability_tags": ["Agentic Workflows", "Advanced Reasoning", "Million-Token Context", "Hybrid Reasoning", "Tool Use", "Function Calling"],
          "preferred_task_types": ["Complex mathematical", "logic problem", "Autonomous code agents", "software development", "High-volume applications", "Long-context document analysis & summarization", "Multi-step agentic tasks"],
          "cost_tier": "low",
          "latency": "slow",
          "context_size": 1000000
        }
      },
      "openai": {
        "model": "gpt-4o",
        "model_fallback": ["gpt-4o-mini"],
        "base_url": "https://api.openai.com/v1",
        "timeout": 120.0,
        "max_tokens": 16000,
        "enable_thinking": false,
        "context_window": 128000,
        "capabilities": {
          "cognitive_complexity": ["L2", "L3"],
          "best_scenarios": ["general", "code_generation", "analysis", "multimodal", "tool_use"],
          "capability_tags": ["code", "tool_use", "multimodal", "general", "reasoning"],
          "preferred_task_types": ["general", "code_generation", "multimodal", "tool_use"],
          "cost_tier": "medium",
          "latency": "medium",
          "context_size": 128000
        }
      },
      "minmax": {
        "model": "MiniMax-Text-01",
        "model_fallback": [],
        "base_url": "https://api.minimax.chat/v1",
        "timeout": 120.0,
        "max_tokens": 4096,
        "enable_thinking": false,
        "context_window": 1000000,
        "capabilities": {
          "cognitive_complexity": ["L1", "L2"],
          "best_scenarios": ["long_document", "summarization", "general"],
          "capability_tags": ["long_context", "summarization", "cost_efficiency", "general"],
          "preferred_task_types": ["summarization", "long_document", "general"],
          "cost_tier": "low",
          "latency": "medium",
          "context_size": 1000000
        }
      },
      "glm": {
        "model": "glm-5.1",
        "model_fallback": ["glm-5v-turbo","glm-4.7"],
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "timeout": 120.0,
        "max_tokens": 16000,
        "enable_thinking": false,
        "context_window": 200000,
        "capabilities": {
          "cognitive_complexity": ["L3","L4"],
          "best_scenarios": ["code", "systems engineering", "tool schedule", "qa", "llm agent"],
          "capability_tags": ["Long-Horizon Agentic Tasks", "Complex Systems Engineering", "Advanced Reasoning & Coding", "Native Function Calling", "Tool Use", "Interleaved & Deep Thinking"],
          "preferred_task_types": ["Long-duration autonomous agent operations", "Complex code generation & debugging", "Terminal-based development & systems administration", "Cybersecurity analysis", "Multi-step research tasks with extensive browsing"],
          "cost_tier": "medium",
          "latency": "medium",
          "context_size": 200000
        }
      },
      "kimi": {
        "model": "kimi-k2.6",
        "model_fallback": ["kimi-k2.5"],
        "base_url": "https://api.moonshot.cn/v1",
        "timeout": 120.0,
        "max_tokens": 16000,
        "enable_thinking": false,
        "context_window": 1000000,
        "capabilities": {
          "cognitive_complexity": ["L2","L3"],
          "best_scenarios": ["deep search", "code generation", "genernal task"],
          "capability_tags": ["Long-Horizon Coding", "Persistent Autonomous Execution", "search", "cost_efficiency", "long_context"],
          "preferred_task_types": ["Full-stack development & DevOps", "Multi-agent collaboration for complex projects", "Long-running autonomous research & reporting"],
          "cost_tier": "medium",
          "latency": "slow",
          "context_size": 1000000
        }
      }
    }
  },
  "context": {
    "chars_per_token_fallback": 3.5,
    "budget":{
      "strategy": "default",
      "role_based": {
        "reserve_ratio": 0.20,
        "role_ratios": {
          "system":    0.1,
          "user":      0.1,
          "assistant": 0.4,
          "tool":      0.4
        }
      },
      "default": {
        "reserve_ratio": 0.30
      }
    },
    "truncation": {
      "strategy": "default",
      "default": {
        "tool_arg_max_chars": 300,
        "tool_result_max_chars": 500,
        "summary_provider": "deepseek",
        "keep_first_units": 1,
        "keep_last_units": 3,
        "summary_ratio": 0.20
      }
    }
  },
  "storage": {
    "backend": "file",
    "file": {
      "path": "tests/runtime/agent_documents.json"
    },
    "sqlite": {
      "allowed_databases": {
        "material_price": "tests/runtime/material_price.db"
      },
      "path": "tests/runtime/material_price.db"
    },
    "chromadb": {
      "persist_directory": "",
      "allowed_collections": ["agent_documents"],
      "collection_name": "agent_documents"
    },
    "mysql": {
      "host": "",
      "port": 3306,
      "allowed_databases": [],
      "database": "",
      "charset": "utf8mb4"
    }
  },
  "tools": {
    "package": null,
    "modules": [],
    "forbidden_tools": [],
    "retry": {
      "max_attempts": 3,
      "backoff_seconds": [1.0, 2.0, 4.0]
    }
  },
  "analyzer":{
    "knowledge_types": ["业务背景", "业务限制", "常用术语", "SOP"],
    "min_confidence": {
      "tool_match": 0.5,
      "user_preference": 0.6,
      "knowledge_entry": 0.6,
      "clarification": 0.6
    }
  },
  "planner": {
    "max_plan_retries": 3,
    "tool_score_filter_threshold": 0.65
  },
  "tracing": {
    "enabled": true,
    "output_path": "var/tracing/traces.jsonl",
    "payload_redaction_enabled": false,
    "max_content_length": 2048
  },
  "log": {
    "dir": "var/logs"
  },
  "model_selector": {
    "circuit_breaker": {
      "enabled": true,
      "immediate_open_codes": [
        "AUTH_FAILED", "PERMISSION_DENIED", "QUOTA_EXCEEDED", "CONFIG_ERROR"
      ],
      "failure_threshold": 2,
      "failure_window_seconds": 60,
      "half_open_success_threshold": 2,
      "cooloff_jitter_ratio": 0.15,
      "default_cooloff_seconds": 30,
      "cooloff_seconds": {
        "AUTH_FAILED":          3600,
        "PERMISSION_DENIED":     600,
        "QUOTA_EXCEEDED":       3600,
        "RATE_LIMITED":           60,
        "HTTP_5XX":               15,
        "PROVIDER_OVERLOADED":    30,
        "NETWORK_ERROR":          10,
        "TIMEOUT":                10,
        "CONTENT_FILTERED":       30,
        "INPUT_CONTENT_POLICY":   30,
        "RESPONSE_ERROR":         15,
        "RESPONSE_PARSE_ERROR":   10,
        "CONTEXT_TOO_LONG":        0,
        "OUTPUT_TOO_LONG":         0,
        "INVALID_REQUEST":         0,
        "CONFIG_ERROR":          3600
      }
    }
  },
  "personality_manager":{
    "max_recent_entries": 50,
    "summary_file": "var/personality/user_preference_summary.md"
  },
  "knowledge": {
    "manager": { "compact_threshold_bytes": 131072 },
    "loader":   { "max_recent_entries": 50, "top_k": 20, "index_dir": "var/knowledge/test_knowledge_base" }
  },
  "pipeline": {
    "knowledge_snippet_chars": 3000,
    "preference_snippet_chars": 2000
  },
  "time": {
    "timezone": "shanghai"
  }
}
